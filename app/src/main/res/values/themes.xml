<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Metadator" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
    </style>

    <!-- The mark on the blue of the icon, so that it shows on the light ground as on the dark. -->
    <style name="Theme.Metadator.Starting" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">@color/background</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/brand</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/metamatik_icon_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Metadator</item>
    </style>
</resources>

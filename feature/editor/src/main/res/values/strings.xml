    <string name="lossless_summary_transcoded">The sound stops dead at %1$s kHz, as an MP3 or AAC of about %2$d kbps does. The file is as large as a real one, but sounds like the lossy one.</string>
    <string name="lossless_summary_probably">The sound stops at %1$s kHz. A lossy file of about %2$d kbps ends there, and so do a few real masters.</string>
    <string name="lossless_summary_shelf">The band above 16 kHz comes and goes, as an MP3 encoder leaves it.</string>
    <string name="lossless_summary_upsampled">A %1$s kHz file whose sound stops at %2$s kHz: audio of a lower resolution saved at a higher sample rate.</string>
    <string name="lossless_summary_padded">A %1$d-bit file that only uses %2$d bits: audio of a lower resolution saved at a higher bit depth.</string>
    <string name="lossless_summary_too_quiet">There is too little sound in it to judge.</string>
    <string name="lossless_summary_low_rate">Its sample rate is too low for the cut of a lossy encoder to show.</string>
    <string name="lossless_summary_borderline">The sound stops at %1$s kHz, between where lossy encoders cut and where real recordings end.</string>
